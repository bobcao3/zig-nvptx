fn isEven(n: u32) bool {
    return if (n == 0) true else isOdd(n - 1);
}

fn isOdd(n: u32) bool {
    return if (n == 0) false else isEven(n - 1);
}

export fn kernel(out: *addrspace(.global) bool, n: u32) callconv(.kernel) void {
    out.* = isEven(n);
}
