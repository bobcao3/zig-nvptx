#zig build-obj {
--name tmp
-target nvptx64-cuda -fno-llvm -fno-lld -fno-incremental
-Mroot=tmp.zig
#}

#write tmp.zig {
const table: [16]f32 addrspace(.constant) = @splat(1.5);

export fn entry(out: *addrspace(.global) f32, i: u32) callconv(.kernel) void {
    @constCast(&table)[i % 16] = 2.0;
    out.* = table[i % 16];
}
#}
#update
#check errors {
tmp.zig:3:8: error: store to address space 'constant'
#}
