#zig build-obj {
--name tmp
-target nvptx64-cuda -fno-llvm -fno-lld -fno-incremental
-Mroot=tmp.zig
#}

#write tmp.zig {
const table: [16]f32 addrspace(.constant) = @splat(1.5);

export fn entry(out: *addrspace(.global) f32, n: usize) callconv(.kernel) void {
    @memset(@constCast(&table)[0..n], 0.0);
    out.* = table[0];
}
#}
#update
#check errors {
tmp.zig:3:8: error: store to address space 'constant'
#}
