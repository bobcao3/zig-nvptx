#zig build-obj {
--name tmp
-target nvptx64-cuda -mcpu sm_121a -fno-llvm -fno-lld -fno-incremental
-Mroot=tmp.zig
#}

#write tmp.zig {
const nv = @import("std").nvptx;

export fn wrongFragment(out: *@Vector(4, f32)) callconv(.kernel) void {
    out.* = nv.mmaSync(.{
        .shape = .m16n8k32,
        .element = .e4m3,
        .accumulator = .f32,
    }, @as(@Vector(2, u32), @splat(0)), @as(@Vector(2, u32), @splat(0)), @as(@Vector(4, f32), @splat(0)));
}

export fn wrongScaleShape(out: *@Vector(4, f32)) callconv(.kernel) void {
    out.* = nv.mmaSyncBlockScale(.{
        .shape = .m16n8k16,
        .element = .e4m3,
        .accumulator = .f32,
    }, .{}, @as(@Vector(2, u32), @splat(0)), @as(@Vector(1, u32), @splat(0)), @as(@Vector(4, f32), @splat(0)), 0, 0);
}

export fn wrongScaleElement(out: *@Vector(4, f32)) callconv(.kernel) void {
    out.* = nv.mmaSyncBlockScale(.{
        .shape = .m16n8k32,
        .element = .e4m3,
        .b_element = .bf16,
        .accumulator = .f32,
    }, .{}, @as(@Vector(4, u32), @splat(0)), @as(@Vector(2, u32), @splat(0)), @as(@Vector(4, f32), @splat(0)), 0, 0);
}

export fn wrongScaleSelector() callconv(.kernel) void {
    const options: nv.matrix.BlockScaleOptions = .{ .a_thread = 2 };
    _ = options;
}
#}
